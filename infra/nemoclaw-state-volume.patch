+// Claw Orchestrator adapter: short managed sandbox names bind to full instance UUIDs.
+// Missing/mismatched bindings fail closed, including during rebuild and cleanup.
+function orchestratorOpenClawVolume(sandboxName: string): string {
+  if (!/^co-[0-9a-f]{16}$/u.test(sandboxName)) {
+    return `${OPENCLAW_STATE_VOLUME_NAME_PREFIX}-${sandboxName}`;
+  }
+  const id = process.env.CLAW_ORCHESTRATOR_INSTANCE_ID ?? "";
+  if (
+    !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u.test(id) ||
+    sandboxName !== `co-${id.replaceAll("-", "").slice(0, 16)}`
+  ) {
+    throw new Error("Claw Orchestrator instance/volume binding is missing or mismatched.");
+  }
+  return `openclaw-data-${id}`;
+}
