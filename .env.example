# Copy to .env, then set a strong password before starting the database.
POSTGRES_DB=claw_orchestrator
POSTGRES_USER=claw_admin
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
# Host access is restricted to 127.0.0.1. Change if the port is already occupied.
POSTGRES_PORT=5432

# Generate all secrets with: uv run scripts/setup_local.py
JWT_SECRET=
DEMO_AUTH_ENABLED=true
CONTROL_ORIGIN=https://app.localhost:8443
INSTANCE_DOMAIN=claw.localhost
PUBLIC_PORT=8443

# OpenRouter is host-side only. Keep a real key in .env (chmod 600), never frontend assets.
INFERENCE_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_CONTEXT_WINDOW=1000000
OPENROUTER_MAX_TOKENS=4096

# Local LM Studio token; leave blank only if local server authentication is disabled.
LMSTUDIO_API_KEY=
